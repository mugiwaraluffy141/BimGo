<Project Sdk="Microsoft.NET.Sdk">

	<!--
		BimGo.Core: shared by the standalone app (BimGo.App) and every Revit add-in build (BimGo.Revit, R25-R27).
		No Revit, no GL, no UI. Holds the scene model, the .bimgo format, edit messages and the edit journal.
		net8.0 so the net8 (R25/R26) and net10 (R27) add-ins can both reference it.
	-->
	<PropertyGroup>
		<TargetFrameworks>net8.0;net48</TargetFrameworks>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>disable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>BimGo</RootNamespace>
		<AssemblyName>BimGo.Core</AssemblyName>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<!-- Missing XML comments on DTO members are not worth failing over -->
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Configurations>Debug;Release</Configurations>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<Reference Include="System.Numerics" />
		<Reference Include="System.IO.Compression" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<!--
		BimGo.App: the standalone walkthrough app (BimGo.exe) and the engine (GL renderer, physics, guns, HUD).
		No Revit references; the add-in launches it (live sessions) and never loads it.

		UseWindowsForms only brings in-box framework pieces (System.Drawing for the font atlas, file dialogs).

		NuGet packages (see the README dependency table; every package needs Gavin's explicit yes):
		  Silk.NET.OpenGL: GL function bindings behind the Native/Gl.cs facade. Context creation stays in Native/Wgl.cs.
		The Revit add-in does not reference this project, so nothing here loads inside Revit.
	-->
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<LangVersion>latest</LangVersion>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>disable</Nullable>
		<PlatformTarget>x64</PlatformTarget>
		<Prefer32Bit>false</Prefer32Bit>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>BimGo</RootNamespace>
		<AssemblyName>BimGo</AssemblyName>
		<Product>BimGo</Product>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
		<Configurations>Debug;Release</Configurations>
		<StartupObject>BimGo.Program</StartupObject>
		<!-- The ">>" icon: embedded in BimGo.exe (Explorer, taskbar pins) and copied beside it for the window class -->
		<ApplicationIcon>Resources\BimGo.ico</ApplicationIcon>
		<!-- Shared install location used by every Revit year's add-in to find BimGo.exe -->
		<BimGoInstallDir>$(LocalAppData)\Programs\BimGo\</BimGoInstallDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<DefineConstants>$(DefineConstants);TRACE</DefineConstants>
		<Optimize>true</Optimize>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BimGo.Core\BimGo.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Pinned. MIT. Pulls in Silk.NET.Core and Silk.NET.Maths (MIT). Do not add Silk.NET.Windowing / Input. -->
		<PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\BimGo.ico" Link="BimGo.ico" CopyToOutputDirectory="PreserveNewest" />
		<!-- Licence texts travel with BimGo.exe (MIT obliges the third-party notices to ship with the binaries) -->
		<None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
		<!-- CC0 proxy textures (Realistic mode stand-ins for missing images): copied beside the exe as Resources\Proxies -->
		<None Update="Resources\Proxies\*.jpg;Resources\Proxies\*.png;Resources\Proxies\proxies.json" CopyToOutputDirectory="PreserveNewest" />
		<!-- Location override: the offline place list (Natural Earth populated places, public domain; ai/261011b_Video_Location/make_places.py) -->
		<None Update="Resources\places.tsv" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!--
		Local builds update the desktop app at the path the Revit add-in uses.
		The packaging script passes DeployBimGoLocally=false to build artifacts only.
	-->
	<Target Name="InstallBimGoApp" AfterTargets="Build" Condition="'$(DeployBimGoLocally)' == 'true' And '$(BimGoInstallDir)' != '' And '$(Configuration)' == 'Debug'">
		<PropertyGroup>
			<_BimGoInstallPath>$([MSBuild]::EnsureTrailingSlash('$(BimGoInstallDir)'))</_BimGoInstallPath>
		</PropertyGroup>
		<ItemGroup>
			<BimGoAppFiles Include="$(TargetDir)**\*.*" Exclude="$(TargetDir)**\*.pdb" />
		</ItemGroup>
		<MakeDir Directories="$(BimGoInstallDir)" />
		<Copy SourceFiles="@(BimGoAppFiles)" DestinationFiles="@(BimGoAppFiles->'$(_BimGoInstallPath)%(RecursiveDir)%(Filename)%(Extension)')"
			  SkipUnchangedFiles="true" />
	</Target>

	<!-- Release local builds must replace the installed app with the complete self-contained runtime. -->
	<Target Name="PublishAndInstallBimGoApp" AfterTargets="Build" Condition="'$(DeployBimGoLocally)' == 'true' And '$(BimGoInstallDir)' != '' And $(Configuration.StartsWith('Release'))">
		<PropertyGroup>
			<_BimGoPublishDir>$(MSBuildProjectDirectory)\obj\$(Configuration)\local-deploy</_BimGoPublishDir>
			<_BimGoInstallPath>$([MSBuild]::EnsureTrailingSlash('$(BimGoInstallDir)'))</_BimGoInstallPath>
		</PropertyGroup>
		<RemoveDir Directories="$(_BimGoPublishDir)" />
		<Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; -c &quot;$(Configuration)&quot; -r win-x64 --self-contained true -p:PublishTrimmed=false -p:PublishSingleFile=false -p:DeployBimGoLocally=false -o &quot;$(_BimGoPublishDir)&quot; --nologo -m:1" />
		<Error Condition="!Exists('$(_BimGoPublishDir)\BimGo.exe') Or !Exists('$(_BimGoPublishDir)\BimGo.runtimeconfig.json') Or !Exists('$(_BimGoPublishDir)\hostfxr.dll') Or !Exists('$(_BimGoPublishDir)\hostpolicy.dll') Or !Exists('$(_BimGoPublishDir)\coreclr.dll')"
			   Text="The self-contained BimGo publish is missing required executable or .NET host files." />
		<MakeDir Directories="$(BimGoInstallDir)" />
		<ItemGroup>
			<_BimGoPublishedFiles Include="$(_BimGoPublishDir)\**\*.*" Exclude="$(_BimGoPublishDir)\**\*.pdb" />
			<_BimGoPublishedFilesNoExe Include="@(_BimGoPublishedFiles)" Exclude="$(_BimGoPublishDir)\BimGo.exe" />
		</ItemGroup>
		<Copy SourceFiles="@(_BimGoPublishedFilesNoExe)" DestinationFiles="@(_BimGoPublishedFilesNoExe->'$(_BimGoInstallPath)%(RecursiveDir)%(Filename)%(Extension)')" />
		<Copy SourceFiles="$(_BimGoPublishDir)\BimGo.exe" DestinationFiles="$(_BimGoInstallPath)BimGo.exe" />
	</Target>

</Project>
